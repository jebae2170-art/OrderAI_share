# order-ai-share — 환경 변수 템플릿
#
# 사용법:
#   cp .env.example .env
#   # 아래에서 본인이 선택한 인증 모드의 값들을 채움
#   # .env 는 .gitignore — 절대 git 커밋 X
#
# 보안 노트:
#   - Password 모드 시 1Password share / GPG encrypted file 로만 전달
#   - plain email / Slack DM / USB unencrypted 금지
#
# 모드 선택 가이드:
#   - 매주 반복하는 /weekly-refresh 루틴에는 **Password 모드 권장** — SSO(externalbrowser)는
#     매 실행마다 브라우저 로그인 팝업이 떠서 반자동 루틴에 부적합.
#   - SSO 모드는 credential 보관이 없다는 장점 — 일회성 조회/검증 용도에 적합.

# ============================================================
# Snowflake 인증 — 두 모드 중 선택
# ============================================================

# 공통 (양쪽 모드 모두 필요)
SNOWFLAKE_ACCOUNT=your_account.ap-northeast-2
SNOWFLAKE_USER=your.email@fnfcorp.co.kr
SNOWFLAKE_WAREHOUSE=DEV_WH
SNOWFLAKE_DATABASE=FNF
SNOWFLAKE_SCHEMA=PRCS
SNOWFLAKE_ROLE=                         # 선택 — SSO 모드면 본인 default role 자동 사용

# ─── 옵션 A: Password — 주간 갱신 루틴(/weekly-refresh) 권장 ─
# IT 발급 service account 또는 본인 계정 password.
# 브라우저 팝업 없이 실행 가능 → 매주 반복 루틴·무인 실행에 적합.
SNOWFLAKE_AUTH=password
SNOWFLAKE_PASSWORD=

# ─── 옵션 B: SSO (externalbrowser) — 일회성 조회용 ──────────
# 사용자 본인 Snowflake login 사용. 브랜드 권한이 본인 role 에 자동 반영.
# credential 을 .env 에 보관하지 않는 장점, 대신 매 실행 브라우저 팝업.
# 사용 시 위 SNOWFLAKE_AUTH/PASSWORD 를 비우고 아래 주석 해제:
# SNOWFLAKE_AUTH=externalbrowser

# ============================================================
# 운영배포 (S3 → EC2) — /weekly-refresh Stage 6 운영배포용
# ============================================================
# S3 Presigned URL API 키 (AX팀 발급, 1Password 전달). 미설정 시 운영배포 단계는
# 건너뛰고 로컬 baseline 반영까지만 수행됨 (갱신·KG검증은 정상 동작).
S3_API_KEY=
# EC2 재시작·서빙검증은 ssh 키 기반 (HANDOVER.md 전달물 참조:
#   ec2-business-user@10.81.3.230 접속용 ssh 키를 ~/.ssh 에 배치).

# ============================================================
# 운영 설정
# ============================================================

# 브랜드는 public/brand_config.json 의 'brand' 필드가 단일 SoT (2026-08-03) —
#   /prepare-pipeline 이 관리하며, 여기에 BRAND 를 둘 필요 없음.
#   (BRAND= 를 설정하면 여전히 존중되지만 brand_config 와 불일치 시 RuntimeError)
DUCKDB_PATH=data/production/order_ai.duckdb
USER_STORAGE_PATH=data/user-storage

# EC2 운영배포 접속 대상 (운영배포 권한 이관 시에만 — 1Password/HANDOVER.md #6)
#   형식: user@host  (ssh 키는 ~/.ssh 에 별도 배치)
EC2_SSH_TARGET=your_user@your.ec2.host
# (선택) 전용 ssh 키 경로 — 기본 ~/.ssh 키(id_rsa 등)가 아닌 별도 키를 쓸 때만 지정.
#   키 "내용"은 절대 .env 에 넣지 말 것 (ssh 는 권한 600 파일만 인식).
# EC2_SSH_KEY_PATH=~/.ssh/orderai_ec2
# ※ dcs-ai-cli API key 는 여기 두지 않음 — 도구가 자체 설정파일만 읽음:
#   `dcs-ai-cli config set` 으로 등록 (SETUP.md §4.5)
